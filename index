<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Life Vision - Quiz Kong</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #f0fdf4; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .glass-panel { background: white; border-radius: 1rem; box-shadow: 0 10px 25px rgba(34, 197, 94, 0.1); }
        .btn-green { background-color: #22c55e; color: white; transition: all 0.2s; }
        .btn-green:hover { background-color: #16a34a; transform: translateY(-2px); }
        .btn-blue { background-color: #3b82f6; color: white; transition: all 0.2s; }
        .btn-blue:hover { background-color: #2563eb; transform: translateY(-2px); }
        .btn-answer { background-color: #e2e8f0; color: #1e293b; transition: all 0.2s; }
        .btn-answer:hover { background-color: #d1d5db; transform: scale(1.02); }
        .correct { background-color: #22c55e !important; color: white !important; }
        .incorrect { background-color: #ef4444 !important; color: white !important; }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

    <div id="app" class="w-full max-w-2xl glass-panel p-8">
        
        <!-- 1. Role Selection Screen -->
        <div id="role-screen" class="text-center">
            <h1 class="text-5xl font-bold text-green-600 mb-4">Quiz Kong</h1>
            <p class="text-gray-500 mb-10 text-lg">Are you hosting a game or joining one?</p>
            
            <div class="flex flex-col gap-4">
                <button onclick="showScreen('setup-screen')" class="btn-green w-full py-4 rounded-xl text-xl font-bold shadow-md">Host a Game</button>
                <button onclick="showScreen('join-screen')" class="btn-blue w-full py-4 rounded-xl text-xl font-bold shadow-md">Join a Game</button>
            </div>
        </div>

        <!-- 2. Host Setup Screen -->
        <div id="setup-screen" class="hidden text-center">
            <h1 class="text-3xl font-bold text-green-600 mb-2">Host Setup</h1>
            <p class="text-gray-500 mb-8">Select the textbook and topic for your students.</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 text-left">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Textbook</label>
                    <select id="book-select" onchange="populateQuizDropdown()" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 outline-none">
                        <option value="Elementary">Life Vision Elementary</option>
                        <option value="Pre-Intermediate">Life Vision Pre-Intermediate</option>
                        <option value="Intermediate">Life Vision Intermediate</option>
                        <option value="Intermediate Plus">Life Vision Intermediate Plus</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Quiz Type</label>
                    <select id="type-select" onchange="populateQuizDropdown()" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 outline-none">
                        <option value="Mixed">Vocab & Grammar (Mixed)</option>
                        <option value="Vocab">Vocabulary Only</option>
                        <option value="Grammar">Grammar Only</option>
                    </select>
                </div>
            </div>

            <div class="relative w-full mb-8 text-left">
                <label class="block text-sm font-medium text-gray-700 mb-1">Specific Lesson Topic</label>
                <select id="quiz-select" class="w-full bg-gray-50 border-2 border-gray-200 text-gray-800 p-4 rounded-lg font-bold text-lg focus:outline-none focus:border-green-500 focus:ring-0 cursor-pointer"></select>
            </div>

            <button onclick="generateGamePin()" class="btn-green w-full py-4 rounded-xl text-xl font-bold shadow-lg">Generate Game PIN</button>
            <button onclick="showScreen('role-screen')" class="mt-4 text-gray-500 hover:text-gray-800 underline">Back</button>
        </div>

        <!-- 3. Host Lobby Screen -->
        <div id="host-lobby-screen" class="hidden text-center">
            <h2 class="text-2xl text-gray-600 mb-2">Join at <span class="font-bold">quizkong.github.io/home/</span> with PIN:</h2>
            <div id="game-pin-display" class="text-6xl font-black text-green-600 tracking-widest mb-8">123456</div>
            <div class="p-6 bg-gray-50 rounded-lg mb-8">
                <p class="text-gray-500">Waiting for players to join...</p>
                <div class="mt-4 text-xl font-bold text-gray-800">Players: 0</div>
            </div>
            <button onclick="startQuiz()" class="btn-green w-full py-4 rounded-xl text-xl font-bold shadow-lg">Start Game</button>
            <button onclick="showScreen('setup-screen')" class="mt-4 text-gray-500 hover:text-gray-800 underline">Back to Setup</button>
        </div>

        <!-- 4. Player Join Screen -->
        <div id="join-screen" class="hidden text-center">
            <h1 class="text-3xl font-bold text-blue-600 mb-6">Join Game</h1>
            <input type="text" id="pin-input" placeholder="Game PIN" class="w-full p-4 mb-4 border-2 border-gray-300 rounded-xl text-center text-xl font-bold focus:border-blue-500 outline-none" autocomplete="off">
            <input type="text" id="name-input" placeholder="Nickname" class="w-full p-4 mb-8 border-2 border-gray-300 rounded-xl text-center text-xl focus:border-blue-500 outline-none" autocomplete="off">
            <button onclick="joinLobby()" class="btn-blue w-full py-4 rounded-xl text-xl font-bold shadow-lg">Enter</button>
            <button onclick="showScreen('role-screen')" class="mt-4 text-gray-500 hover:text-gray-800 underline">Back</button>
        </div>

        <!-- 5. Player Waiting Screen -->
        <div id="player-waiting-screen" class="hidden text-center">
            <h2 class="text-3xl font-bold text-blue-600 mb-4">You're in!</h2>
            <p class="text-xl text-gray-600">See your nickname on the teacher's screen.</p>
            <div class="mt-8 animate-pulse text-gray-400">Waiting for host to start...</div>
            <button onclick="startQuiz()" class="mt-12 text-sm text-gray-400 underline hover:text-gray-600">Simulate Host Starting Game</button>
        </div>

        <!-- 6. Active Quiz Screen -->
        <div id="quiz-screen" class="hidden">
            <div class="flex justify-between items-center mb-6">
                <span id="question-counter" class="text-green-600 font-bold bg-green-100 px-3 py-1 rounded-full">Question 1/10</span>
                <span id="score-display" class="text-gray-600 font-bold">Score: 0</span>
            </div>
            
            <h2 id="question-text" class="text-2xl font-bold text-gray-800 mb-8 text-center">Loading question...</h2>
            
            <div id="answers-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Answer buttons generated via JS -->
            </div>
        </div>

        <!-- 7. Results Screen -->
        <div id="results-screen" class="hidden text-center">
            <h2 class="text-4xl font-bold text-green-600 mb-4">Quiz Complete!</h2>
            <p class="text-2xl text-gray-700 mb-8">Final Score: <span id="final-score" class="font-bold text-green-600">0</span></p>
            <button onclick="resetApp()" class="btn-green px-8 py-3 rounded-xl text-lg font-bold">Play Again</button>
        </div>

    </div>

    <script>
        // --- SYLLABUS DEFINITIONS ---
        // Ties quiz names directly to the book units and topics
        const syllabusData = {
            "Elementary": [
                { unit: 1, vName: "Daily Routines & Free Time", gName: "Present Simple" },
                { unit: 2, vName: "Sport, Fitness & Food", gName: "Adverbs of Frequency" },
                { unit: 3, vName: "Clothes & Character", gName: "Present Continuous" },
                { unit: 4, vName: "Houses & Places", gName: "Comparatives" },
                { unit: 5, vName: "Art & Entertainment", gName: "Past Simple" },
                { unit: 6, vName: "Technology & Everyday Items", gName: "Irregular Verbs" },
                { unit: 7, vName: "Life Goals & Jobs", gName: "Be Going To" },
                { unit: 8, vName: "Travel & Holidays", gName: "Present Perfect" }
            ],
            "Pre-Intermediate": [
                { unit: 1, vName: "A Day Out & Travel", gName: "Past Simple & Q Forms" },
                { unit: 2, vName: "Housework & Homes", gName: "Past Continuous" },
                { unit: 3, vName: "Healthy Lifestyles & Food", gName: "Quantifiers & Modals" },
                { unit: 4, vName: "Weather & Disasters", gName: "Future & Conditionals" },
                { unit: 5, vName: "School & After-school", gName: "Verbs & Conditionals" },
                { unit: 6, vName: "Life Experiences & Stages", gName: "Present Perfect vs Past" },
                { unit: 7, vName: "Space & Inventions", gName: "Relative Clauses" },
                { unit: 8, vName: "Jobs & Shopping", gName: "Passive Forms" }
            ],
            "Intermediate": [
                { unit: 1, vName: "Games & Entertainment", gName: "Narrative Tenses" },
                { unit: 2, vName: "Friendships & Feelings", gName: "Present Perfect & Used To" },
                { unit: 3, vName: "Going Online & Numbers", gName: "Modals of Deduction" },
                { unit: 4, vName: "Sport & Exercise", gName: "Quantifiers" },
                { unit: 5, vName: "Senses & Food", gName: "Future Tenses" },
                { unit: 6, vName: "Travel & Homes", gName: "Relative Clauses" },
                { unit: 7, vName: "Social Issues & Education", gName: "Reported Speech" },
                { unit: 8, vName: "Shopping & Crime", gName: "Third Conditional" }
            ],
            "Intermediate Plus": [
                { unit: 1, vName: "Film-making & Written Word", gName: "Present Tenses" },
                { unit: 2, vName: "Geography & Environment", gName: "Future Continuous & Perfect" },
                { unit: 3, vName: "Illnesses & Treatments", gName: "Question Forms" },
                { unit: 4, vName: "Personality & Family", gName: "Reported Speech" },
                { unit: 5, vName: "Global Trade & Finance", gName: "Modals (Advice & Obligation)" },
                { unit: 6, vName: "Homes & Property", gName: "Relative Clauses" },
                { unit: 7, vName: "Higher Education & Study", gName: "Verb Patterns" },
                { unit: 8, vName: "Job Applications & Crime", gName: "Habitual Behaviour" }
            ]
        };

        // --- RAW QUESTION DATA ---
        const rawQuestions = {
            "vocab": [
                { q: "You cook food in the ___.", a: ["kitchen", "bathroom", "bedroom", "hall"] },
                { q: "Neil Armstrong was the first human to stand on the ___ of the moon.", a: ["surface", "atmosphere", "gravity", "space"] },
                { q: "We went on a guided ___ of the ancient ruins.", a: ["tour", "trip", "journey", "walk"] },
                { q: "I always put dirty clothes in the washing ___.", a: ["machine", "box", "cooker", "fridge"] },
                { q: "You use a ___ to hit the ball in tennis.", a: ["racket", "net", "pitch", "goal"] },
                { q: "To stay healthy, do a ___ at the gym.", a: ["workout", "competition", "diet", "track"] },
                { q: "Sending a fake email to try to get someone's personal details is ___.", a: ["phishing", "hacking", "cyberbullying", "trolling"] },
                { question: "The city council wants to reduce greenhouse gas ___.", a: ["emissions", "resources", "waste", "panels"] },
                { q: "A long period without rain is a ___.", a: ["drought", "flood", "tsunami", "heatwave"] },
                { q: "Breaking into a computer system to steal info is called ___.", a: ["hacking", "phishing", "cyberbullying", "trolling"] }
            ],
            "grammar": [
                { q: "He ___ to school every day.", a: ["goes", "go", "going", "is go"] },
                { q: "While I ___ my room, I found my old phone.", a: ["was tidying", "tidied", "have tidied", "am tidying"] },
                { q: "I ___ up the Eiffel Tower because I'm scared of heights.", a: ["didn't go", "haven't gone", "don't go", "wasn't going"] },
                { q: "If I ___ you, I would tell her the truth.", a: ["were", "am", "will be", "had been"] },
                { q: "By the time I am 30, much of the rainforest ___ disappeared.", a: ["will have", "will be", "would have", "has"] },
                { q: "The building, ___ was designed by a famous architect, opened yesterday.", a: ["which", "that", "who", "where"] },
                { q: "Look! It ___ raining.", a: ["is", "are", "am", "does"] },
                { q: "A city is ___ than a village.", a: ["bigger", "more big", "biggest", "big"] },
                { q: "She has never ___ sushi.", a: ["eaten", "eat", "ate", "eating"] },
                { q: "___ you ever been to a live concert?", a: ["Have", "Did", "Were", "Are"] }
            ]
        };

        // --- QUIZ GENERATION ENGINE ---
        // Dynamically creates the 200+ quizzes matching the exact syllabus
        const QUIZ_LIBRARY = {};

        function shuffleArray(array) {
            let shuffled = array.slice();
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }
            return shuffled;
        }

        // Generate 10 mock questions for the selected type
        function getTenQuestions(type) {
            let qs = [];
            let source = (type === "Vocab") ? rawQuestions.vocab : rawQuestions.grammar;
            
            // Mix both arrays if type is "Mixed"
            if (type === "Mixed") {
                let v = shuffleArray(rawQuestions.vocab).slice(0, 5);
                let g = shuffleArray(rawQuestions.grammar).slice(0, 5);
                source = v.concat(g);
            }

            let shuffledSource = shuffleArray(source);
            
            for(let i=0; i<10; i++) {
                // Repeat questions if we run out of mock data
                let qData = shuffledSource[i % shuffledSource.length];
                qs.push({
                    question: qData.q || qData.question,
                    options: qData.a || qData.options || qData.answers,
                    answer: 0 // The first item in our mock arrays is always the correct one
                });
            }
            return qs;
        }

        // Build the library based on the syllabus
        for (const book in syllabusData) {
            
            // 1. Build Unit-Specific Quizzes
            syllabusData[book].forEach(u => {
                
                // Vocab Only
                QUIZ_LIBRARY[`${book}_v_${u.unit}`] = {
                    book: book, type: "Vocab",
                    title: `[VOCAB] Unit ${u.unit}: ${u.vName}`,
                    questions: getTenQuestions("Vocab")
                };

                // Grammar Only
                QUIZ_LIBRARY[`${book}_g_${u.unit}`] = {
                    book: book, type: "Grammar",
                    title: `[GRAMMAR] Unit ${u.unit}: ${u.gName}`,
                    questions: getTenQuestions("Grammar")
                };

                // Mixed Unit Review
                QUIZ_LIBRARY[`${book}_m_${u.unit}`] = {
                    book: book, type: "Mixed",
                    title: `[MIXED] Unit ${u.unit}: ${u.vName} & ${u.gName}`,
                    questions: getTenQuestions("Mixed")
                };
            });

            // 2. Build Extra Mixed Reviews (To reach the 220 total)
            for (let i = 9; i <= 25; i++) {
                QUIZ_LIBRARY[`${book}_m_${i}`] = {
                    book: book, type: "Mixed",
                    title: `[MIXED] Full Book Review ${i - 8}`,
                    questions: getTenQuestions("Mixed")
                };
                QUIZ_LIBRARY[`${book}_v_${i}`] = {
                    book: book, type: "Vocab",
                    title: `[VOCAB] Extra Review ${i - 8}`,
                    questions: getTenQuestions("Vocab")
                };
                QUIZ_LIBRARY[`${book}_g_${i}`] = {
                    book: book, type: "Grammar",
                    title: `[GRAMMAR] Extra Review ${i - 8}`,
                    questions: getTenQuestions("Grammar")
                };
            }
        }


        // --- UI INTERACTION LOGIC ---

        function showScreen(screenId) {
            const screens = ['role-screen', 'setup-screen', 'host-lobby-screen', 'join-screen', 'player-waiting-screen', 'quiz-screen', 'results-screen'];
            screens.forEach(s => {
                const el = document.getElementById(s);
                if(el) el.classList.add('hidden');
            });
            const active = document.getElementById(screenId);
            if(active) active.classList.remove('hidden');
        }

        function populateQuizDropdown() {
            const quizSelect = document.getElementById('quiz-select');
            const bookFilter = document.getElementById('book-select').value;
            const typeFilter = document.getElementById('type-select').value;
            
            quizSelect.innerHTML = '';

            for (const [key, quiz] of Object.entries(QUIZ_LIBRARY)) {
                if (quiz.book !== bookFilter) continue;
                if (quiz.type !== typeFilter) continue;
                
                const option = document.createElement('option');
                option.value = key;
                option.textContent = quiz.title;
                option.className = "bg-white text-gray-800 font-bold";
                quizSelect.appendChild(option);
            }
        }

        function generateGamePin() {
            const pin = Math.floor(100000 + Math.random() * 900000); 
            document.getElementById('game-pin-display').innerText = pin;
            showScreen('host-lobby-screen');
        }

        function joinLobby() {
            const pin = document.getElementById('pin-input').value;
            const name = document.getElementById('name-input').value;
            if (pin.length > 3 && name.length > 0) {
                showScreen('player-waiting-screen');
            } else {
                alert("Please enter a valid PIN and Nickname.");
            }
        }

        // --- GAME PLAY LOGIC ---

        let currentQuestions = [];
        let currentQIndex = 0;
        let score = 0;
        let canAnswer = true;

        function startQuiz() {
            const quizSelect = document.getElementById('quiz-select');
            let selectedQuizKey = quizSelect.value;
            
            // Fallback if none selected
            if(!selectedQuizKey) selectedQuizKey = Object.keys(QUIZ_LIBRARY)[0];

            currentQuestions = QUIZ_LIBRARY[selectedQuizKey].questions;
            currentQIndex = 0;
            score = 0;
            
            showScreen('quiz-screen');
            loadQuestion();
        }

        function loadQuestion() {
            canAnswer = true;
            const qData = currentQuestions[currentQIndex];
            
            document.getElementById('question-counter').innerText = `Question ${currentQIndex + 1}/${currentQuestions.length}`;
            document.getElementById('score-display').innerText = `Score: ${score}`;
            document.getElementById('question-text').innerText = qData.question;
            
            const grid = document.getElementById('answers-grid');
            grid.innerHTML = '';
            
            // Shuffle answers for display so the correct one isn't always first
            let displayOptions = qData.options.map((opt, index) => ({ text: opt, isCorrect: index === qData.answer }));
            displayOptions = shuffleArray(displayOptions);

            displayOptions.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'btn-answer w-full p-4 text-lg font-semibold rounded-xl border-2 border-transparent shadow-sm';
                btn.innerText = opt.text;
                btn.onclick = () => selectAnswer(opt.isCorrect, btn, grid, displayOptions);
                grid.appendChild(btn);
            });
        }

        function selectAnswer(isCorrect, btn, grid, displayOptions) {
            if (!canAnswer) return;
            canAnswer = false;
            
            if (isCorrect) {
                btn.classList.add('correct');
                score += 100;
            } else {
                btn.classList.add('incorrect');
                // Highlight the correct one
                const correctIndex = displayOptions.findIndex(o => o.isCorrect);
                grid.children[correctIndex].classList.add('correct');
            }
            
            document.getElementById('score-display').innerText = `Score: ${score}`;
            
            setTimeout(() => {
                currentQIndex++;
                if (currentQIndex < currentQuestions.length) {
                    loadQuestion();
                } else {
                    showScreen('results-screen');
                    document.getElementById('final-score').innerText = score;
                }
            }, 1500);
        }

        function resetApp() {
            showScreen('role-screen');
        }

        // Initialize dropdowns on load
        window.onload = () => {
            populateQuizDropdown();
        };
    </script>
</body>
</html>
